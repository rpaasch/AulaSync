<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AulaSync.App.ConfirmUninstallWindow"
        Title="Afinstallér AulaSync" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border Classes="footer" DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" Margin="0,16,0,0">
      <StackPanel x:Name="Buttons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Annullér" IsCancel="True" Click="Cancel" />
        <Button x:Name="Primary" Classes="danger" Content="Afinstallér" Click="Confirm" />
      </StackPanel>
    </Border>
    <StackPanel Margin="18,18,18,0" Spacing="8">
      <TextBlock Classes="h3" FontSize="16" Text="Afinstallér AulaSync?" />
      <TextBlock TextWrapping="Wrap"
                 Text="Programmet, start ved login, dit login, dine indstillinger, loggen og kalenderfilerne slettes." />
      <TextBlock TextWrapping="Wrap"
                 Text="Kalenderne fra AulaSync i dit kalenderprogram bliver ikke opdateret mere. Slet dem dér." />
    </StackPanel>
  </DockPanel>
</Window>
