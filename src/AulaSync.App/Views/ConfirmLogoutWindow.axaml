<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AulaSync.App.ConfirmLogoutWindow"
        Title="Log ud" Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border Classes="footer" DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" Margin="0,16,0,0">
      <StackPanel x:Name="Buttons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Annullér" IsCancel="True" Click="Cancel" />
        <Button x:Name="Primary" Classes="danger" Content="Log ud" Click="Confirm" />
      </StackPanel>
    </Border>
    <StackPanel Margin="18,18,18,0" Spacing="8">
      <TextBlock Classes="h3" FontSize="16" Text="Log ud af AulaSync?" />
      <TextBlock TextWrapping="Wrap"
                 Text="Browserprofilen, de hentede lister og dine valgte skemaer slettes. Kalenderfilerne bliver liggende, til du vælger skemaer igen." />
    </StackPanel>
  </DockPanel>
</Window>
