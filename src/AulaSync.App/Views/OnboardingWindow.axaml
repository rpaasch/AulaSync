<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:app="using:AulaSync.App"
        x:Class="AulaSync.App.OnboardingWindow"
        x:DataType="app:OnboardingViewModel"
        Title="Kom i gang med AulaSync" Width="600" Height="640" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border Classes="footer" DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" IsVisible="{Binding ShowFooter}">
      <StackPanel x:Name="Buttons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Tilbage" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
        <Button x:Name="Primary" Classes="accent" Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}"
                IsEnabled="{Binding CanContinue}" IsDefault="True" />
      </StackPanel>
    </Border>

    <DockPanel Margin="18,18,18,0">
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Progress}" Margin="0,0,0,14" AutomationProperties.AccessibilityView="Raw">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="sys:Boolean">
            <Border Classes="step" Classes.on="{Binding}" Margin="3,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Panel>
        <!-- Trin 1: Velkommen -->
        <StackPanel IsVisible="{Binding IsWelcome}" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
          <TextBlock Classes="h3" Text="Velkommen til AulaSync" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding WelcomeText}" TextWrapping="Wrap" TextAlignment="Center" />
          <Button Classes="accent" Content="Log ind med Aula" Command="{Binding LogInCommand}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Trin 2: Login i samme vindue -->
        <ContentControl x:Name="LoginHost" IsVisible="{Binding IsLogin}" Margin="0,0,0,16" />

        <!-- Trin 3: Kalenderprogram -->
        <StackPanel IsVisible="{Binding IsCalendarApp}">
          <TextBlock Classes="h3" Text="Hvilket kalenderprogram bruger du?" />
          <TextBlock Classes="muted" Text="Du kan altid ændre det i Indstillinger." Margin="0,6,0,14" />
          <Border Classes="hint" Margin="0,0,0,14">
            <TextBlock Text="{x:Static app:OnboardingViewModel.SameComputerText}" />
          </Border>
          <app:CalendarCardsView />
          <Border Classes="hint" IsVisible="{Binding ShowOutlookHint}">
            <TextBlock Text="Ved du ikke, om du har ny Outlook? Står der Ny Outlook med en kontakt, der er slået til, øverst i Outlook, så bruger du ny Outlook." />
          </Border>
        </StackPanel>

        <!-- Trin 4: Vælg skemaer (eget skema er forudvalgt) -->
        <DockPanel IsVisible="{Binding IsSchedules}">
          <TextBlock DockPanel.Dock="Top" Classes="h3" Text="Vælg skemaer" Margin="0,0,0,12" />
          <app:AddScheduleView DataContext="{Binding Add}" Margin="0,0,0,16" />
        </DockPanel>

        <!-- Trin 5: Tilføj til din kalender -->
        <DockPanel IsVisible="{Binding IsAddToCalendar}">
          <TextBlock DockPanel.Dock="Top" Classes="h3" Text="Tilføj til din kalender" Margin="0,0,0,12" />
          <TextBlock DockPanel.Dock="Bottom" Classes="sub" Text="{Binding FinishMessage}" TextWrapping="Wrap" Margin="0,0,0,16" />
          <Border DockPanel.Dock="Bottom" Classes="hint" Margin="0,0,0,12" IsVisible="{Binding ShowAppleCalendarHint}">
            <TextBlock Text="Når Kalender spørger, så vælg Placering: På min Mac (ikke iCloud)." />
          </Border>
          <Border Classes="list" Margin="0,0,0,16">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Main.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:ScheduleRowViewModel">
                    <app:ScheduleRowView />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Panel>
    </DockPanel>
  </DockPanel>
</Window>
