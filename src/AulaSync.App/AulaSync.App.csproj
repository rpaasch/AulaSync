<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AulaSync.App</RootNamespace>
    <AssemblyName>AulaSync</AssemblyName>
    <Version>3.2.1</Version>
    <Product>AulaSync</Product>
    <AssemblyTitle>AulaSync</AssemblyTitle>
    <Description>Holder skemaer fra Aula opdateret i din kalender</Description>
    <Copyright>Copyright (c) 2026 Rasmus Paasch</Copyright>
    <!-- Ikonet tegnes af packaging/icon/make-icons.py -->
    <ApplicationIcon>..\..\packaging\icon\AulaSync.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Windows: login-webviewet kræver et manifest med understøttede Windows-versioner (se app.manifest) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AulaSync.Core\AulaSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\packaging\icon\AulaSync.ico" Link="Assets\AulaSync.ico" />
    <AvaloniaResource Include="..\..\packaging\icon\tray\*" Link="Assets\Tray\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AulaSync.App.Tests" />
  </ItemGroup>

</Project>
