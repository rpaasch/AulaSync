<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AulaSync.App.App"
             Name="AulaSync"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AulaSync/Theme/AulaSyncTheme.axaml" />
  </Application.Styles>
</Application>
