          <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="Surface2Brush" />
          <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Surface2Brush" />
          <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="Surface2Brush" />
          <StaticResource x:Key="TextControlBorderBrush" ResourceKey="LineBrush" />
          <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="LineBrush" />
          <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="LineBrush" />
          <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="LineBrush" />
          <StaticResource x:Key="TextControlForeground" ResourceKey="InkBrush" />
          <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="InkBrush" />
          <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="InkBrush" />
          <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="DisabledInkBrush" />
          <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="PlaceholderBrush" />
          <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="SelectionBrush" />
          <!-- Fluent: ComboBox (select) -->
          <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="Surface2Brush" />
          <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="ControlPressedBrush" />
          <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="Surface2Brush" />
          <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="Transparent" />
          <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="Transparent" />
          <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="LineBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="LineBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="LineStrongBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="LineBrush" />
          <StaticResource x:Key="ComboBoxForeground" ResourceKey="InkBrush" />
          <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="InkBrush" />
          <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="InkBrush" />
          <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="DisabledInkBrush" />
          <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="PlaceholderBrush" />
          <StaticResource x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" ResourceKey="PlaceholderBrush" />
