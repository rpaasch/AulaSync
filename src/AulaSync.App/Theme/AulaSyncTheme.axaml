          <StaticResource x:Key="CheckBoxForegroundUncheckedPointerOver" ResourceKey="InkBrush" />
          <StaticResource x:Key="CheckBoxForegroundUncheckedPressed" ResourceKey="InkBrush" />
          <StaticResource x:Key="CheckBoxForegroundChecked" ResourceKey="InkBrush" />
          <StaticResource x:Key="CheckBoxForegroundCheckedPointerOver" ResourceKey="InkBrush" />
          <StaticResource x:Key="CheckBoxForegroundCheckedPressed" ResourceKey="InkBrush" />
          <StaticResource x:Key="CheckBoxForegroundUncheckedDisabled" ResourceKey="DisabledInkBrush" />
          <StaticResource x:Key="CheckBoxForegroundCheckedDisabled" ResourceKey="DisabledInkBrush" />
          <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="Surface2Brush" />
          <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="ControlPressedBrush" />
          <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" ResourceKey="Surface2Brush" />
          <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="LineStrongBrush" />
