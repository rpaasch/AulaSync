<!-- Farver og former fra UI-mockuppen (docs/superpowers/specs/ui-mockup.html), i lys og mørk tilstand. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SurfaceBrush" Color="#ffffff" />
          <SolidColorBrush x:Key="Surface2Brush" Color="#f6f7f9" />
          <SolidColorBrush x:Key="LineBrush" Color="#d5d9e1" />
          <SolidColorBrush x:Key="MutedBrush" Color="#5d6577" />
          <SolidColorBrush x:Key="OkBrush" Color="#1f8a4c" />
          <SolidColorBrush x:Key="WarnBrush" Color="#b26a00" />
          <SolidColorBrush x:Key="BadBrush" Color="#c2372f" />
          <SolidColorBrush x:Key="WarnBackgroundBrush" Color="#fff4e0" />
          <SolidColorBrush x:Key="BadBackgroundBrush" Color="#fdecea" />
          <SolidColorBrush x:Key="StaffBrush" Color="#e3ecfb" />
          <SolidColorBrush x:Key="StaffInkBrush" Color="#21539f" />
          <SolidColorBrush x:Key="ClassBrush" Color="#e5f4ea" />
          <SolidColorBrush x:Key="ClassInkBrush" Color="#1f6b3d" />
          <SolidColorBrush x:Key="RoomBrush" Color="#f4ebfa" />
          <SolidColorBrush x:Key="RoomInkBrush" Color="#6b3590" />
          <!-- Kontrol-tokens (mockup: ink, accent, accent-ink) + afledte hover/pressed-toner -->
          <SolidColorBrush x:Key="InkBrush" Color="#1d2330" />
          <SolidColorBrush x:Key="AccentBrush" Color="#2f6fde" />
          <SolidColorBrush x:Key="AccentInkBrush" Color="#ffffff" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#2a64c9" />
          <SolidColorBrush x:Key="AccentPressedBrush" Color="#2458b3" />
          <SolidColorBrush x:Key="BadHoverBrush" Color="#ae312a" />
          <SolidColorBrush x:Key="BadPressedBrush" Color="#9a2b25" />
          <SolidColorBrush x:Key="ControlPressedBrush" Color="#eceef2" />
          <SolidColorBrush x:Key="LineStrongBrush" Color="#c3c8d2" />
          <SolidColorBrush x:Key="DisabledInkBrush" Color="#a1a7b3" />
          <SolidColorBrush x:Key="SelectionBrush" Color="#b3d0f7" />
          <SolidColorBrush x:Key="PlaceholderBrush" Color="#757575" />
          <BoxShadows x:Key="FocusRing">0 0 0 4 #2f6fde, 0 0 0 2 #ffffff</BoxShadows>

          <!-- Fluent: Button -->
          <StaticResource x:Key="ButtonBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="Surface2Brush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlPressedBrush" />
          <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="Surface2Brush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="InkBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="InkBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="InkBrush" />
          <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="DisabledInkBrush" />
          <StaticResource x:Key="ButtonBorderBrush" ResourceKey="LineBrush" />
          <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="LineBrush" />
          <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="LineStrongBrush" />
          <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="LineBrush" />
          <!-- Fluent: Button.accent -->
          <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentBrush" />
          <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentHoverBrush" />
          <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AccentPressedBrush" />
          <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="Surface2Brush" />
          <StaticResource x:Key="AccentButtonForeground" ResourceKey="AccentInkBrush" />
          <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="AccentInkBrush" />
          <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="AccentInkBrush" />
          <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="DisabledInkBrush" />
          <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="AccentBrush" />
          <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="AccentHoverBrush" />
          <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="AccentPressedBrush" />
          <StaticResource x:Key="AccentButtonBorderBrushDisabled" ResourceKey="LineBrush" />
          <!-- Fluent: ToggleButton (filter-segment) -->
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
          <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="Surface2Brush" />
          <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="ControlPressedBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="AccentHoverBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="AccentPressedBrush" />
          <StaticResource x:Key="ToggleButtonForeground" ResourceKey="InkBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="InkBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="InkBrush" />
          <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentInkBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentInkBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentInkBrush" />
          <!-- Fluent: TextBox (.search) -->
