          <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="InkBrush" />
          <StaticResource x:Key="ComboBoxDropDownGlyphForegroundDisabled" ResourceKey="DisabledInkBrush" />
          <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="LineBrush" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="Transparent" />
          <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="AccentPressedBrush" />
          <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="AccentPressedBrush" />
          <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="InkBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="InkBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="AccentInkBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="AccentInkBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="AccentInkBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="AccentInkBrush" />
          <!-- Fluent: CheckBox -->
