          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#ffffff" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#ffffff" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#ffffff" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#ffffff" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#ffffff" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#ffffff" />
          <!-- Fokusring for de øvrige Fluent-kontroller (ToggleSwitch, kort, menupunkter) -->
          <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="AccentBrush" />
          <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
          <!-- Valgt kort ved første start -->
          <BoxShadows x:Key="CardRingShadow">0 0 0 3 #385B93F5</BoxShadows>

        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Fluent: størrelser (fælles for lys/mørk) -->
      <Thickness x:Key="ButtonPadding">12,5</Thickness>
      <Thickness x:Key="TextControlThemePadding">11,8</Thickness>
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
      <x:Double x:Key="TextControlPlaceholderOpacity">1</x:Double>
      <Thickness x:Key="ComboBoxPadding">9,4,0,4</Thickness>
      <x:Double x:Key="ComboBoxMinHeight">28</x:Double>
      <Thickness x:Key="ComboBoxDropdownBorderPadding">4</Thickness>
      <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
      <Thickness x:Key="ComboBoxItemThemePadding">10,6</Thickness>
      <x:Double x:Key="CheckBoxMinHeight">24</x:Double>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <Thickness x:Key="MenuFlyoutScrollerMargin">4</Thickness>
      <GridLength x:Key="ToggleSwitchPreContentMargin">0</GridLength>
      <GridLength x:Key="ToggleSwitchPostContentMargin">0</GridLength>
      <Thickness x:Key="ToggleSwitchOuterBorderStrokeThickness">0</Thickness>

      <!-- Valgkortene ved første start (mockup .card): hvid flade, tynd kant, blå kant og ring, når valgt -->
      <ControlTheme x:Key="CalendarCard" TargetType="RadioButton">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Card">
          <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Card">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BoxShadow" Value="{DynamicResource CardRingShadow}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Overskrifter og tekst -->
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.19" />
  </Style>
  <Style Selector="TextBlock.name">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.sub.error">
    <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
  </Style>
  <Style Selector="TextBlock.mode">
    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="TextBlock.mode.ok">
    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
  </Style>
  <Style Selector="TextBlock.done">
    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <Style Selector="TextBlock.done.waiting">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.step">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Margin" Value="0,12,0,6" />
  </Style>

  <!-- Typemærke: initialer / klasse / lokalenummer i et farvet felt -->
  <Style Selector="Border.badge">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge.staff">
    <Setter Property="Background" Value="{DynamicResource StaffBrush}" />
  </Style>
  <Style Selector="Border.badge.staff > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StaffInkBrush}" />
  </Style>
  <Style Selector="Border.badge.class">
    <Setter Property="Background" Value="{DynamicResource ClassBrush}" />
  </Style>
  <Style Selector="Border.badge.class > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ClassInkBrush}" />
  </Style>
  <Style Selector="Border.badge.room">
    <Setter Property="Background" Value="{DynamicResource RoomBrush}" />
  </Style>
  <Style Selector="Border.badge.room > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RoomInkBrush}" />
  </Style>

  <!-- Flader -->
  <Style Selector="Border.list">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Border.item">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <!-- Sidste række i en liste med kant: ingen skillelinje under den, listens kant er der allerede -->
  <Style Selector="Border.list ContentPresenter:nth-last-child(1) Border.item">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.item.grouped">
    <Setter Property="BorderThickness" Value="1,0,1,1" />
  </Style>
  <Style Selector="Border.item.grouped.first">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9,9,0,0" />
  </Style>
  <Style Selector="Border.item.grouped.last">
    <Setter Property="CornerRadius" Value="0,0,9,9" />
  </Style>
  <Style Selector="Border.item.grouped.first.last">
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <!-- Filter som segmenteret kontrol (mockup .seg) -->
  <Style Selector="Border.seg">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="ToggleButton.seg">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,5" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource WarnBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Border.footer">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="18,11" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource WarnBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="99" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.confirm">
    <Setter Property="Background" Value="{DynamicResource BadBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="11,9" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Border.hint">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="11,9" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <Style Selector="Border.hint > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.step">
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="Border.step.on">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.number">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.number > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Statusprik i bundlinjen: grøn / gul / rød -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.dot.warning">
    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="Ellipse.dot.error">
    <Setter Property="Fill" Value="{DynamicResource BadBrush}" />
  </Style>

  <!-- Knapper: ghost og danger skal også styre template-delen, ellers vinder Fluents :pointerover/:pressed -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource BadBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BadHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BadPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- ===== Kontroller (mockup .btn / .btn.primary / .btn.icon / .search / select / .seg) ===== -->
  <Style Selector="Button, ToggleButton, ComboBox">
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <!-- Avalonia 12: TemplatedControl.ClipToBounds er true som standard; ellers klippes fokusringen væk -->
  <Style Selector="Button, ToggleButton, TextBox, ComboBox, CheckBox, TextBox /template/ DataValidationErrors, ComboBox /template/ DataValidationErrors">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Button, ToggleButton">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" CornerRadius="9" Margin="-4" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button:pressed, ToggleButton:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Button.accent, Button.danger">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BoxShadow" Value="{DynamicResource FocusRing}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BoxShadow" Value="{DynamicResource FocusRing}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="CheckBox /template/ Viewbox">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="CheckBox:focus-visible /template/ Border#NormalRectangle">
    <Setter Property="BoxShadow" Value="{DynamicResource FocusRing}" />
  </Style>

  <!-- "⋯"-menuen som en Mac-menu (mockup .menu) -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="220" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter Separator">
    <Setter Property="Margin" Value="2,4" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
  </Style>

  <!-- Kontakten (mockup .toggle, 38×22). Skabelonen sætter mål direkte på delene; derfor :checked/:unchecked-par,
       som vinder over dem. Margin ophæver skabelonens faste kolonne på 12 til højre. -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Margin" Value="0,0,-12,0" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#OuterBorder, ToggleSwitch:unchecked /template/ Border#OuterBorder, ToggleSwitch:checked /template/ Border#SwitchKnobBounds, ToggleSwitch:unchecked /template/ Border#SwitchKnobBounds">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Canvas#PART_SwitchKnob, ToggleSwitch:unchecked /template/ Canvas#PART_SwitchKnob">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Grid#PART_MovingKnobs, ToggleSwitch:unchecked /template/ Grid#PART_MovingKnobs">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn, ToggleSwitch:unchecked /template/ Ellipse#SwitchKnobOn, ToggleSwitch:checked /template/ Ellipse#SwitchKnobOff, ToggleSwitch:unchecked /template/ Ellipse#SwitchKnobOff">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>

  <!-- Tekst på valgkortene -->
  <Style Selector="RadioButton TextBlock.sub">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="15" />
    <Setter Property="Margin" Value="0" />
  </Style>
</Styles>
